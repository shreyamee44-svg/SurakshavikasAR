44|  onSurface: "#111827", // text and icons on the canvas
45|  surfaceSecondary: "#F9FAFB", // cards, sheets, list rows
46|  onSurfaceSecondary: "#374151", // text and icons on cards, sheets, rows
47|  surfaceTertiary: "#F3F4F6", // input backgrounds, chips, deepest nesting
