88|export type ThemeColors = typeof light;
89|
90|export const defaultScheme = "light" satisfies ColorScheme;
91|
92|export const themes: { light: ThemeColors; dark?: ThemeColors } = { light };
93|
94|// In-app theme toggle, only after `dark` exists in `themes`. Call
95|// setColorScheme("dark"), setColorScheme("light"), or setColorScheme(null) to
96|// follow the device. Every useTheme() consumer re-renders. Persisting the
97|// choice and re-applying it on launch is the toggle's job.
98|export function setColorScheme(scheme: ColorScheme | null) {
99|  // RN 0.86 re-reads the device scheme only for the literal "unspecified";
100|  // null would pin useColorScheme() to null and the app to light.
101|  Appearance.setColorScheme?.(scheme ?? "unspecified");
102|}
103|
104|// Keep native surfaces (alerts, pickers, navigation chrome) on the schemes this
105|// app ships: light only forces light; once `dark` exists the device decides.
106|// Optional call because react-native-web does not implement it.
107|setColorScheme?.(themes.dark ? null : defaultScheme);
108|
109|export function useTheme(): { scheme: ColorScheme; colors: ThemeColors } {
110|  const system = useColorScheme();
111|  const scheme: ColorScheme = system && themes[system] ? system : defaultScheme;
112|  return { scheme, colors: themes[scheme] ?? themes.light };
113|}
114|
115|// Themed StyleSheet: returns a hook that builds the sheet from the active
116|// scheme's colors and memoizes it until the scheme changes.
117|export function makeStyles<T extends StyleSheet.NamedStyles<T> | StyleSheet.NamedStyles<any>>(
118|  factory: (colors: ThemeColors) => T & StyleSheet.NamedStyles<any>,
119|): () => T {
120|  return function useStyles(): T {
121|    const { colors } = useTheme();
122|    return useMemo(() => StyleSheet.create(factory(colors)), [colors]);
123|  };
124|}
