49|  surfaceInverse: "#1F2937", // tooltips, snackbars, anything popping against the theme
50|  onSurfaceInverse: "#FFFFFF", // text and icons on the inverse surface
51|  muted: "#6B7280", // subdued text on surface: captions, timestamps, placeholders
52|
