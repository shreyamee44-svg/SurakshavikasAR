55|  // Neutral by default; replace with the design guidelines values.
56|  // ---------------------------------------------------------------------------
57|  brand: "#111827", // base hue, anchor only; Primary, Secondary, Tertiary are weights of it
58|  onBrand: "#FFFFFF", // text and icons placed directly on brand
59|  brandPrimary: "#111827", // primary CTA, active tab indicator, selected states
60|  onBrandPrimary: "#FFFFFF", // text and icons on brandPrimary
61|  brandSecondary: "#E5E7EB", // secondary CTA, less prominent accents
62|  onBrandSecondary: "#111827", // text and icons on brandSecondary
63|  brandTertiary: "#F3F4F6", // chips, tags, badges, subtle brand moments
