          <View style={styles.languageRow}>{(Object.keys(languageLabels) as Language[]).map((item) => <Pressable key={item} onPress={() => setLanguage(item)} accessibilityRole="button" testID={`language-${item}`} style={[styles.languageChip, language === item && styles.languageChipActive]}><Text style={[styles.languageText, language === item && styles.languageTextActive]}>{languageLabels[item]}</Text></Pressable>)}</View>
          <Text style={styles.inputLabel}>{t(copy.workerName)}</Text><TextInput value={name} onChangeText={setName} placeholder={t(copy.namePlaceholder)} placeholderTextColor={colors.muted} style={styles.input} autoCapitalize="words" testID="worker-name-input" />
          <Text style={styles.inputLabel}>{t(copy.employeeId)}</Text><TextInput value={employeeId} onChangeText={setEmployeeId} placeholder={t(copy.idPlaceholder)} placeholderTextColor={colors.muted} style={styles.input} autoCapitalize="characters" testID="employee-id-input" />
          {error ? <Text style={styles.error}>{error}</Text> : null}
          <PrimaryButton onPress={handleEnter} disabled={saving} testID="enter-field-button">{saving ? "Saving…" : t(copy.continue)} <AppIcon name="arrow-right" size={17} color={colors.onBrandPrimary} /></PrimaryButton>
        </GlassCard>
        <View style={styles.trustRow}><AppIcon name="wifi-off" size={17} color={colors.success} /><Text style={styles.trustText}>{t(copy.syncReady)} • data syncs when online</Text></View>
      </ScrollView>
    </KeyboardAvoidingView>
  );

  return <ScrollView style={styles.root} contentContainerStyle={{ paddingTop: insets.top + 20, paddingBottom: 24 }} showsVerticalScrollIndicator={false}>
    <View style={styles.header}><BrandMark compact /><View style={styles.headerRight}><View style={styles.syncBadge}><View style={styles.syncDot} /><Text style={styles.syncText}>OFFLINE READY</Text></View><Pressable style={styles.avatar}><Text style={styles.avatarText}>{worker.name.charAt(0).toUpperCase()}</Text></Pressable></View></View>
    <View style={styles.greeting}><Text style={styles.eyebrow}>SAFETY COMMAND CENTER</Text><Text style={styles.dashboardTitle}>Namaste, {worker.name.split(" ")[0]}.</Text><Text style={styles.dashboardSubtitle}>Your next safe move starts here.</Text></View>
    <GlassCard style={styles.statusCard}><View style={styles.statusIcon}><AppIcon name="cloud-check" size={22} color={colors.success} /></View><View style={styles.statusCopy}><Text style={styles.statusTitle}>{t(copy.syncReady)}</Text><Text style={styles.statusDescription}>2 modules available on this device</Text></View><AppIcon name="chevron-right" size={20} color={colors.muted} /></GlassCard>
    <View style={styles.statsRow}><View style={styles.stat}><Text style={styles.statValue}>02</Text><Text style={styles.statLabel}>ACTIVE PACKS</Text></View><View style={styles.statDivider} /><View style={styles.stat}><Text style={styles.statValue}>00%</Text><Text style={styles.statLabel}>COMPLETED</Text></View><View style={styles.statDivider} /><View style={styles.stat}><Text style={styles.statValue}>24/7</Text><Text style={styles.statLabel}>FIELD ACCESS</Text></View></View>
    <View style={styles.sectionHeader}><Text style={styles.sectionTitle}>{t(copy.modules)}</Text><Text style={styles.sectionHint}>2 of 5 loaded</Text></View>
    {modules.map((module, index) => { const active = module.steps.length > 0; const accent = colors[module.accent === "brand" ? "brandPrimary" : module.accent]; return <Pressable key={module.id} onPress={() => active && router.push({ pathname: "/train/[module]", params: { module: module.id } })} style={({ pressed }) => [styles.moduleCard, pressed && active && styles.pressed, !active && styles.lockedCard]} testID={`module-${module.id}`}><View style={[styles.moduleIcon, { backgroundColor: active ? `${accent}22` : colors.surfaceTertiary }]}><AppIcon name={module.icon as keyof typeof import("@expo/vector-icons").MaterialCommunityIcons.glyphMap} size={26} color={active ? accent : colors.muted} /></View><View style={styles.moduleBody}><View style={styles.moduleTop}><Text style={styles.moduleTitle}>{t(module.title)}</Text>{active ? <Text style={[styles.available, { color: accent }]}>READY</Text> : <Text style={styles.locked}>LOCKED</Text>}</View><Text style={styles.moduleSubtitle}>{t(module.subtitle)}</Text><ProgressBar value={active ? 0 : 0} color={accent} /><Text style={styles.moduleMeta}>{module.duration} · {active ? "AR + assessment" : "Next content pack"}</Text></View><AppIcon name={active ? "chevron-right" : "lock-outline"} size={20} color={active ? colors.onSurfaceTertiary : colors.muted} /></Pressable>; })}
